# Server
PORT=
MONGO_URI=
CLIENT_URL=
REDIS_URL=

# Apify
APIFY_TIMEOUT_SECS=
# Optional server-level fallback token used for analytics. Users supply their own token via account settings.
APIFY_TOKEN=
# Legacy fallback for the LinkedIn actor ID (kept for backwards compat)
APIFY_ACTOR_ID=

# Per-actor IDs. Defaults are baked into the actor modules; set these only to override.
APIFY_ACTOR_LINKEDIN=
APIFY_ACTOR_INDEED=
APIFY_ACTOR_GLASSDOOR=
APIFY_ACTOR_WELLFOUND=

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Auth
SESSION_SECRET=

# Resend (transactional email — used for register OTPs)
RESEND_API_KEY=
RESEND_FROM=
